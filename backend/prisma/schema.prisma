generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organisation {
  id            String   @id @default(uuid())
  name          String

  nom_admin     String
  email         String   @unique
  password      String

  phone_org     String?
  nb_employers  Int?

  users         User[]
  workflows     Workflow[]
  jobOffers     JobOffer[]
  documents     Document[]
  tasks         Task[]

  orgInfo       OrgInfo?

  createdAt     DateTime @default(now())

  @@index([email])
}

model OrgInfo {
  id             String        @id @default(uuid())

  logo           String?       
  domaine        String?       
 address   String?
  city      String?

  website   String?
  organisationId String        @unique
  organisation   Organisation  @relation(fields: [organisationId], references: [id])

  createdAt      DateTime @default(now())
}

model User {
  id        String @id @default(uuid())
  email     String @unique
  password  String
  firstName String
  lastName  String

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  admin    Admin?
  manager  Manager?
  rh       RH?
  employee Employee?

  tasks         Task[]
  notifications Notification[]
  documents     Document[]
  eventLogs     EventLog[]
  jobOffers     JobOffer[]

  createdAt DateTime @default(now())

  @@index([organisationId])
}
enum ContractType {
  CDI
  CDD
  STAGE
  FREELANCE
  ALTERNANCE
}

enum JobLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
  INTERN
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}
model JobOffer {
  id          String @id @default(uuid())
  title       String
  description String

  contractType ContractType
  level        JobLevel
  workMode     WorkMode

  skills       String[]   // competences required (PostgreSQL supports arrays)

  budget    Float?

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
}
enum CandidateStatus {
  CANDIDATE
  CONTACTED
  INTERVIEW
  ACCEPTED
  REJECTED
}
model Candidate {
  id    String @id @default(uuid())
  email String @unique

  fullName String
  phone    String?
  cv       String?   
  status   CandidateStatus @default(CANDIDATE)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Application {
  id String @id @default(uuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  jobOfferId String
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id])

  processInstanceId String?          @unique
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])

  aiAnalyses AIAnalysis[]
  documents  Document[]

  status String @default("APPLIED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, jobOfferId])
}

model Document {
  id       String @id @default(uuid())
  fileName String
  fileUrl  String
  docType  String

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Manager {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model RH {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Employee {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

// --- WORKFLOW & TASKS ---
model Workflow {
  id             String            @id @default(uuid())
  name           String
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id])
  steps          Step[]
  instances      ProcessInstance[]
}

model Step {
  id         String   @id @default(uuid())
  name       String
  order      Int
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])
  rules      Rule[]
  tasks      Task[] // Modèle de tâches pour cette étape
}

model Task {
  id      String    @id @default(uuid())
  title   String
  status  String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  dueDate DateTime?

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  processInstanceId String
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id])

  stepId String
  step   Step   @relation(fields: [stepId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([organisationId])
}

model Rule {
  id     String @id @default(uuid())
  logic  Json
  stepId String
  step   Step   @relation(fields: [stepId], references: [id])
}

model ProcessInstance {
  id         String   @id @default(uuid())
  status     String   @default("IN_PROGRESS")
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  tasks       Task[] // L-khidma li t-at-dar f had l-instance
  aiAnalyses  AIAnalysis[] // Natarijat d l-IA l-had l-instance
  application Application?
  logs        EventLog[]

  createdAt DateTime @default(now())
}

// --- INTELLIGENCE ARTIFICIELLE ---
model AIAnalysis {
  id         String @id @default(uuid())
  type       String // "CV_SCORING", "BOTTLENECK", "SUMMARIZATION"
  result     Json // L-natatija d l-IA (score, texte, etc.)
  confidence Float? // Nivo d l-tiqa d l-IA

  processInstanceId String?
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  createdAt DateTime @default(now())
}

// --- NOTIFICATIONS & DOCUMENTS ---
model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String // "EMAIL", "IN_APP", "PUSH"
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model EventLog {
  id                String          @id @default(uuid())
  action            String
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  processInstanceId String
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id])
  createdAt         DateTime        @default(now())
}
