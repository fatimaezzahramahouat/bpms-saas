generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organisation {
  id           String     @id @default(uuid())
  name         String
  nom_admin    String
  email        String     @unique
  password     String
  phone_org    String?
  nb_employers Int?
  createdAt    DateTime   @default(now())
  documents    Document[]
  jobOffers    JobOffer[]
  orgInfo      OrgInfo?
  tasks        Task[]
  users        User[]
  workflows    Workflow[]

  @@index([email])
}

model OrgInfo {
  id             String       @id @default(uuid())
  logo           String?
  domaine        String?
  address        String?
  city           String?
  website        String?
  organisationId String       @unique
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id])
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  firstName      String
  lastName       String
  organisationId String
  createdAt      DateTime       @default(now())
  resetExpires   DateTime?
  resetToken     String?        @unique
  admin          Admin?
  documents      Document[]
  employee       Employee?
  eventLogs      EventLog[]
  jobOffers      JobOffer[]
  manager        Manager?
  notifications  Notification[]
  rh             RH?
  tasks          Task[]
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  processInstances ProcessInstance[]

  @@index([organisationId])
}

enum JobOfferStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  FILLED
  CANCELLED
}
enum StatusSource {
  MANUAL
  AUTOMATIC
}

model JobOffer {
  id               String         @id @default(uuid())
  title            String
  organisationId   String
  createdById      String
  budget           Float?
  contractType     ContractType
  createdAt        DateTime       @default(now())
  description      String
  level            JobLevel
  responsibilities String[]       @default([])
  skills           String[]
  updatedAt        DateTime       @updatedAt
  workMode         WorkMode
  closedAt         DateTime?
  publishedAt      DateTime?
  status           JobOfferStatus @default(PUBLISHED)
  workflowId       String?
  statusSource     StatusSource   @default(MANUAL)
  applications     Application[]
  createdBy        User           @relation(fields: [createdById], references: [id])
  organisation     Organisation   @relation(fields: [organisationId], references: [id])
  Workflow         Workflow?      @relation(fields: [workflowId], references: [id])

  @@index([organisationId])
  @@index([status])
}

model Candidate {
  id           String          @id @default(uuid())
  email        String          @unique
  fullName     String
  phone        String?
  cv           String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  status       CandidateStatus @default(CANDIDATE)
  applications Application[]
}

model Application {
  id                String           @id @default(uuid())
  candidateId       String
  jobOfferId        String
  processInstanceId String?          @unique
  status            String           @default("APPLIED")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  aiAnalyses        AIAnalysis[]
  candidate         Candidate        @relation(fields: [candidateId], references: [id])
  jobOffer          JobOffer         @relation(fields: [jobOfferId], references: [id])
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])
  documents         Document[]

  @@unique([candidateId, jobOfferId])
}

model Document {
  id             String        @id @default(uuid())
  fileName       String
  fileUrl        String
  docType        String
  applicationId  String?
  userId         String?
  organisationId String?
  application    Application?  @relation(fields: [applicationId], references: [id])
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Manager {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model RH {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Employee {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Workflow {
  id             String            @id @default(uuid())
  name           String
  organisationId String
  createdAt      DateTime          @default(now())
  description    String?
  edges          Json?             @default("[]")
  nodes          Json?             @default("[]")
  status         WorkflowStatus    @default(DRAFT)
  updatedAt      DateTime          @updatedAt
  version        Int               @default(1)
  instances      ProcessInstance[]
  steps          Step[]
  jobOffers      JobOffer[]
  organisation   Organisation      @relation(fields: [organisationId], references: [id])

  @@index([status])
  @@index([organisationId])
}

model Step {
  id         String   @id @default(uuid())
  name       String
  order      Int
  workflowId String
  metadata   Json?
  rules      Rule[]
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks      Task[]
}

model Task {
  id                String          @id @default(uuid())
  title             String
  status            String          @default("PENDING")
  dueDate           DateTime?
  userId            String?
  processInstanceId String
  stepId            String
  organisationId    String
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  organisation      Organisation    @relation(fields: [organisationId], references: [id])
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id])
  step              Step            @relation(fields: [stepId], references: [id])
  user              User?           @relation(fields: [userId], references: [id])

  @@index([organisationId])
}

model Rule {
  id     String @id @default(uuid())
  logic  Json
  stepId String
  step   Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model ProcessInstance {
  id          String       @id @default(uuid())
  status      String       @default("IN_PROGRESS")
  workflowId  String
  userId      String?
  context     Json?
  createdAt   DateTime     @default(now())
  aiAnalyses  AIAnalysis[]
  application Application?
  logs        EventLog[]
  workflow    Workflow     @relation(fields: [workflowId], references: [id])
  tasks       Task[]
  user        User?        @relation(fields: [userId], references: [id])
}

model AIAnalysis {
  id                String           @id @default(uuid())
  type              String
  result            Json
  confidence        Float?
  processInstanceId String?
  applicationId     String?
  createdAt         DateTime         @default(now())
  application       Application?     @relation(fields: [applicationId], references: [id])
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model EventLog {
  id                String          @id @default(uuid())
  action            String
  userId            String?
  processInstanceId String
  createdAt         DateTime        @default(now())
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id])
  user              User?           @relation(fields: [userId], references: [id])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ContractType {
  CDI
  CDD
  STAGE
  FREELANCE
  ALTERNANCE
}

enum JobLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
  INTERN
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}

enum CandidateStatus {
  CANDIDATE
  CONTACTED
  INTERVIEW
  ACCEPTED
  REJECTED
}

